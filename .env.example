# ============================================
# SPSE Crawler — Environment Variables
# Copy this file to .env and fill in values
# ============================================

# ----------------------------------------------------------
# Django (required in production)
# ----------------------------------------------------------
DJANGO_DEBUG=0
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
DJANGO_SECRET_KEY=
# Comma-separated, no protocol prefix:
ALLOWED_HOSTS=monitor-lpse.khansia.co.id
# Comma-separated, full URLs:
CSRF_TRUSTED_ORIGINS=https://monitor-lpse.khansia.co.id

# ----------------------------------------------------------
# Database (required in production)
# ----------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# ----------------------------------------------------------
# Crawler settings
# ----------------------------------------------------------
SPSE_LOG_LEVEL=INFO
SPSE_HEADLESS=1

# ----------------------------------------------------------
# Seed data (optional — stable password for all seed accounts)
# ----------------------------------------------------------
# Applied deterministically by `python manage.py seed_data`. Priority:
# --password CLI > SEED_PASSWORD > SPSE_SEED_PASSWORD > documented default
# (SpseSeed!2026). Set a strong value before deploying; change anyway after
# first login on production.
# SEED_PASSWORD=ChangeMe!Strong2026

# ----------------------------------------------------------
# AI Scoring (optional — defaults to rule-based, zero cost)
# ----------------------------------------------------------
# Provider: openai | gemini | anthropic | rule_based
AI_PROVIDER=rule_based
# AI_BASE_URL=https://ai.sumopod.com/v1
# AI_API_KEY=your-api-key
# AI_MODEL=MiniMax-M2.7-highspeed

# ----------------------------------------------------------
# Gunicorn (optional)
# ----------------------------------------------------------
# GUNICORN_WORKERS=4
